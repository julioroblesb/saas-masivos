{
  "name": "saas-masivos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "test": "npm run test --workspace=web",
    "test:integration": "npm run test:integration --workspace=web",
    "test:e2e": "npm run test:e2e --workspace=web",
    "build": "npm run build --workspace=web",
    "db:coverage": "node scripts/check-schema-coverage.mjs",
    "db:validate": "node scripts/validate-migrations.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "format": "prettier --write \"*.{json,md}\" \".github/**/*.yml\" \"docs/**/*.{json,md}\" \"apps/web/*.{json,md,mjs}\"",
    "format:check": "prettier --check \"*.{json,md}\" \".github/**/*.yml\" \"docs/**/*.{json,md}\" \"apps/web/*.{json,md,mjs}\"",
    "check": "npm run security:secrets && npm run db:validate && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    },
    "minimatch": "^10.2.4"
  }
}
